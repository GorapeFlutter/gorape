Application:
  Server:
    port: 8000
    # Optional direct TLS listener. Keep both paths empty when TLS terminates
    # at a trusted reverse proxy; when enabled, the server also serves HTTPS.
    tls_port: 8443
    tls_cert_file: ""
    tls_key_file: ""
    log_level: info
    challenge_ttl: 5m
    redis: {challenge_prefix: "gorape:challenge:"}
    oidc: {audience: gorape-api, required_scopes: [openid], provider_urls: {}}
    authentication_assurance:
      # Enable only after Keycloak emits auth_time, matching acr and passkey amr
      # in the validated access token.
      enabled: false
      required_acr: ""
      max_auth_age: ""
    attestation:
      android_trust_anchors: []
      revocation:
        # Enable issuer-provided CRL/OCSP checks. Enabled checks fail closed.
        enabled: false
        timeout: 5s
        cache_ttl: 1m
      # Required to report Android attestation as implemented. Values are
      # package-name -> allowed lowercase SHA-256 signing-certificate digests.
      android_policy:
        applications: {}
        minimum_os_version: 0
        minimum_os_patch_level: 0
        minimum_vendor_patch_level: 0
        minimum_boot_patch_level: 0
      webauthn:
        # Strict by default: no formats, no attestation:none, and no self-attestation.
        allowed_formats: []
        allow_none: false
        allow_self_attestation: false
        trust_anchors:
          android-key: []
          tpm: []
          apple: []
        mds:
          # Enable only after reviewing and accepting the FIDO MDS legal header.
          enabled: false
          cache_file: ""
          url: "https://mds.fidoalliance.org/"
          accept_legal_header: false
    # Configure a stable RP ID distinct from Keycloak and every permitted
    # app/browser origin to enable Gorape device passkeys. Do not reuse the
    # localhost-only development configuration from server.yaml.docker in prod.
    webauthn:
      rp_id: ""
      rp_display_name: Gorape
      rp_origins: []
      portal_origin: ""
      browser_api_origin: ""
      attestation_conveyance: direct
      user_verification: required
    # Exact web app origins allowed to call the API through CORS.
    web_origins: []
    # Platform administrators can provision projects, roles and Keycloak
    # resources through /v1/platform/provisioning/{plan,apply}.
    platform:
      issuer: https://keycloak.example.com/realms/gorape
      provider_url: ""
      admin_roles: [gorape-platform-admin]
    # Optional. When base_url is set, the server can apply Keycloak manifests.
    # Prefer a confidential client with realm-management roles in production.
    keycloak:
      base_url: ""
      auth_realm: master
      admin_realm: gorape
      client_id: gorape-provisioner
      client_secret: ""
      username: ""
      password: ""
PostgreSQL: {host: localhost, user: user, pass: password, port: "5432", db: gorape, sslmode: disable}
Redis: {host: localhost, port: 6379, user: default, pass: mysecretpassword, db: 0}
Logger: {component: gorape, service: gorape, level: INFO, structured: true, output: stdout}
