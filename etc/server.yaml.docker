Application:
  Server:
    host: ""
    port: 8000
    tls_port: 8443
    tls_cert_file: ""
    tls_key_file: ""
    challenge_ttl: 5m
    redis: {challenge_prefix: "gorape:challenge:"}
    oidc:
      audience: gorape-api
      required_scopes: [openid]
      provider_urls:
        http://idp.gorapeflutter.site:8080/realms/gorape: http://keycloak:8080/realms/gorape
        https://idp.gorapeflutter.site:8443/realms/gorape: http://keycloak:8080/realms/gorape
        https://idp.gorapeflutter.site:9443/realms/gorape: http://keycloak:8080/realms/gorape
        https://idp.gorapeflutter.site/realms/gorape: http://keycloak:8080/realms/gorape
        http://localhost:8080/realms/gorape: http://keycloak:8080/realms/gorape
    authentication_assurance:
      enabled: false
      required_acr: ""
      max_auth_age: ""
    attestation:
      android_trust_anchors: []
      revocation:
        enabled: false
        timeout: 5s
        cache_ttl: 1m
      android_policy:
        applications: {}
        minimum_os_version: 0
        minimum_os_patch_level: 0
        minimum_vendor_patch_level: 0
        minimum_boot_patch_level: 0
      webauthn:
        # Request direct attestation for hardware-assurance testing. Providers
        # may still return none; do not accept it as a hardware-backed result.
        allowed_formats: [android-key, tpm, apple, packed, fido-u2f]
        allow_none: false
        allow_self_attestation: false
        trust_anchors:
          android-key: []
          tpm: []
          apple: []
        mds:
          enabled: false
          cache_file: ""
          url: "https://mds.fidoalliance.org/"
          accept_legal_header: false
        # This local policy allows standard credentials with verified
        # attestation, but rejects fmt=none. High assurance additionally sets
        # required: hardware_attested and allow_synced_passkeys: false.
        assurance:
          required: standard_passkey
          allow_synced_passkeys: true
          hardware_formats: [android-key, apple, tpm, fido-u2f]
    webauthn:
      # Official GorapeFlutter development/verification RP ID; DAL and AASA
      # statements live under https://gorapeflutter.site/.well-known/ while
      # Keycloak remains a separate RP (idp.gorapeflutter.site).
      rp_id: gorapeflutter.site
      rp_display_name: Gorape
      rp_origins:
        - https://gorapeflutter.site
        - https://app.gorapeflutter.site
        - https://app.gorapeflutter.site:5173
        - https://app.gorapeflutter.site:5174
        - https://local.gorapeflutter.site:5173
        - https://local.gorapeflutter.site:5174
        - https://api.gorapeflutter.site
        - https://api.gorapeflutter.site:8443
        - http://localhost:5173
        - https://localhost:5173
        - https://localhost:5174
        - http://localhost:8000
        - https://localhost:8443
      portal_origin: "https://app.gorapeflutter.site:5174"
      browser_api_origin: "https://api.gorapeflutter.site:8443"
      attestation_conveyance: direct
      user_verification: required
    web_origins:
      - https://gorapeflutter.site
      - https://app.gorapeflutter.site
      - https://app.gorapeflutter.site:5173
      - https://app.gorapeflutter.site:5174
      - https://local.gorapeflutter.site:5173
      - https://local.gorapeflutter.site:5174
      - http://localhost:5173
      - https://localhost:5173
      - https://localhost:5174
      - http://127.0.0.1:5173
    platform:
      issuer: https://idp.gorapeflutter.site:9443/realms/gorape
      provider_url: http://keycloak:8080/realms/gorape
      admin_roles: [gorape-platform-admin, admin]
    keycloak:
      base_url: http://keycloak:8080
      auth_realm: master
      admin_realm: gorape
      client_id: admin-cli
      username: admin
      password: admin
PostgreSQL: {host: postgres, user: user, pass: password, port: "5432", db: gorape, sslmode: disable}
Redis: {host: redis, port: 6379, user: default, pass: mysecretpassword, db: 0}
Logger: {component: gorape, service: gorape, level: INFO, structured: true, output: stdout}
