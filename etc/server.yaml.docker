Application:
  Server:
    port: 8000
    tls_port: 8443
    tls_cert_file: ""
    tls_key_file: ""
    challenge_ttl: 5m
    redis: {challenge_prefix: "gorape:challenge:"}
    oidc:
      audience: gorape-api
      required_scopes: [openid]
      provider_urls:
        http://localhost:8080/realms/gorape: http://keycloak:8080/realms/gorape
    authentication_assurance:
      enabled: false
      required_acr: ""
      max_auth_age: ""
    attestation:
      android_trust_anchors: []
      revocation:
        enabled: false
        timeout: 5s
        cache_ttl: 1m
      android_policy:
        applications: {}
        minimum_os_version: 0
        minimum_os_patch_level: 0
        minimum_vendor_patch_level: 0
        minimum_boot_patch_level: 0
      webauthn:
        # Local-device testing only: Android's Credential Manager may return
        # fmt=none. Keep the tracked production example default-deny.
        allowed_formats: [android-key, tpm, apple, packed, fido-u2f]
        allow_none: true
        allow_self_attestation: false
        trust_anchors:
          android-key: []
          tpm: []
          apple: []
        mds:
          enabled: false
          cache_file: ""
          url: "https://mds.fidoalliance.org/"
          accept_legal_header: false
    webauthn:
      rp_id: localhost
      rp_display_name: Gorape
      rp_origins:
        - http://localhost:5173
        - https://localhost:5173
        - https://localhost:5174
        - http://localhost:8000
        - https://localhost:8443
      portal_origin: "http://localhost:5173"
      browser_api_origin: "http://localhost:8000"
      attestation_conveyance: none
      user_verification: required
    web_origins:
      - http://localhost:5173
      - https://localhost:5173
      - https://localhost:5174
      - http://127.0.0.1:5173
      - https://gorapeflutter.github.io
      - https://local.gorapeflutter.github.io:5173
      - https://local.gorapeflutter.github.io:5174
    platform:
      issuer: http://localhost:8080/realms/gorape
      provider_url: http://keycloak:8080/realms/gorape
      admin_roles: [gorape-platform-admin, admin]
    keycloak:
      base_url: http://keycloak:8080
      auth_realm: master
      admin_realm: gorape
      client_id: admin-cli
      username: admin
      password: admin
PostgreSQL: {host: postgres, user: user, pass: password, port: "5432", db: gorape, sslmode: disable}
Redis: {host: redis, port: 6379, user: default, pass: mysecretpassword, db: 0}
Logger: {component: gorape, service: gorape, level: INFO, structured: true, output: stdout}
